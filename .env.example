# Server-only managed services, provision via Vercel Marketplace / Storage.
# No secret values belong in GitHub or NEXT_PUBLIC_ environment variables.
DATABASE_URL=
# Connected private Blob normally supplies OIDC + BLOB_STORE_ID on Vercel.
BLOB_STORE_ID=
# Optional fallback token for non-OIDC environments. Never commit the value.
BLOB_READ_WRITE_TOKEN=
# Authentication must be implemented before enabling any client-data routes.
AUTH_SECRET=
