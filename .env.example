# Server-only environment variables. Configure secrets in Vercel Settings.
# Do not commit credentials or client information to GitHub.
DATABASE_URL=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Single-user Auth.js credentials login. Both are required in Production.
# AUTH_SECRET must contain at least 32 unpredictable characters.
AUTH_SECRET=
# Unique strong password (minimum 16 characters), stored as a Vercel Sensitive/Secret variable.
OMEGA_LOGIN_PASSWORD=
# The one permitted login is fixed in server code to info@omegafinancial.ie.
